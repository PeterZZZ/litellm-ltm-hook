# The signer beside Open WebUI 0.6.5 (step 10a). Copy to $ENV_DIR/owui-signer.env, chmod 600.
# Open WebUI's forwarded-user secret: the one the platform verifies (console.env COMPANY_OWUI_SECRET,
# or the registry's app key, step 9). It belongs beside Open WebUI, never in litellm.env.
FORWARD_USER_INFO_HEADER_JWT_SECRET=<the same secret as openwebui.env>
SIGNER_PORT=4012
SIGNER_UPSTREAM=http://127.0.0.1:4011
FORWARD_USER_INFO_HEADER_JWT_EXPIRES_SECONDS=300
