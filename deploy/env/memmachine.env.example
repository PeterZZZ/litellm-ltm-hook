# MemMachine core and Qdrant. Copy to $ENV_DIR/memmachine.env, chmod 600.
# Core reads HOST/PORT from the environment and everything else from cfg.yml.
HOST=127.0.0.1
PORT=8090
MEMORY_CONFIG=/opt/ltm-platform-env/memmachine/cfg.yml
# Qdrant (the same file feeds both units).
QDRANT__SERVICE__HOST=127.0.0.1
QDRANT__SERVICE__HTTP_PORT=6333
QDRANT__SERVICE__GRPC_PORT=6334
QDRANT__STORAGE__STORAGE_PATH=/opt/ltm-platform-env/data/qdrant/storage
QDRANT__STORAGE__SNAPSHOTS_PATH=/opt/ltm-platform-env/data/qdrant/snapshots
