# Mock platform. Copy to $ENV_DIR/platform.env, chmod 600.
PLATFORM_PORT=8100
MOCK_PLATFORM_DB=/opt/ltm-platform-env/platform/registry.sqlite
MOCK_PLATFORM_CORE_URL=http://127.0.0.1:8090
MOCK_PLATFORM_CORE_TIMEOUT=60
# Read-only LiteLLM key (proxy_admin_viewer) so the platform finds personal keys itself.
MOCK_PLATFORM_LITELLM_URL=http://127.0.0.1:4011
MOCK_PLATFORM_LITELLM_KEY=<the memmachine-platform viewer key, step 8>
# How often the platform reconciles its keys with LiteLLM (seconds; 0 = only from the portal).
MOCK_PLATFORM_RECONCILE_SECONDS=600
# Corp SSO: portal sign-in and employee-ID lookups.
MOCK_PLATFORM_OIDC_ISSUER=http://127.0.0.1:8180/realms/corp
MOCK_PLATFORM_OIDC_CLIENT_ID=memmachine-platform
MOCK_PLATFORM_OIDC_CLIENT_SECRET=<PLATFORM_OIDC_CLIENT_SECRET from keycloak-clients.env>
# 1 (default): anyone Corp SSO knows enrols themselves on first use, with a default
# project. 0: admins create every account.
MOCK_PLATFORM_AUTO_ENROL=1
# Only used when the OIDC_* lines are absent: portal passwords checked by Open WebUI.
MOCK_PLATFORM_OWUI_URL=http://127.0.0.1:8087
