# LiteLLM with the hook in platform mode. Copy to $ENV_DIR/litellm.env, chmod 600.
LITELLM_PORT=4011
LITELLM_MASTER_KEY=<sk-...: generate, see SETUP.md step 4>
DATABASE_URL=postgresql://ltmplatform:<LITELLM_DB_PASSWORD, step 3>@127.0.0.1:5432/ltmplatform
STORE_MODEL_IN_DB=False
# Provider keys for the models in litellm-config.yaml: the chat model (DeepInfra
# in the template) and core's embedding model (OpenAI). Step 4.
DEEPINFRA_API_KEY=<DeepInfra key>
OPENAI_API_KEY=<OpenAI key, for text-embedding-3-small>

# The hook proposes person + namespace, the platform verifies.
MEMMACHINE_BASE_URL=http://127.0.0.1:8100
MEMMACHINE_API_KEY=<mm-svc-...: printed by `mock_platform.admin service add`, step 9>
# With the platform's mutual TLS on (SETUP.md step 9a): the TLS port, and this
# LiteLLM's certificate (CN = its service label).
#MEMMACHINE_BASE_URL=https://127.0.0.1:8443
#MEMMACHINE_CA_CERT=/opt/ltm-platform-env/litellm/tls/ca.crt
#MEMMACHINE_CLIENT_CERT=/opt/ltm-platform-env/litellm/tls/litellm-ltm-platform-env.crt
#MEMMACHINE_CLIENT_KEY=/opt/ltm-platform-env/litellm/tls/litellm-ltm-platform-env.key
MEMMACHINE_TIMEOUT=60
MEMMACHINE_MODEL_PREFIX=memmachine-
MEMMACHINE_PROJECT_ID=default
MEMMACHINE_DEBUG=0
# Which claim of Open WebUI's token names the person: name with Corp SSO (Open
# WebUI copies employee_id into the user's name), email without SSO (phase 1).
MEMMACHINE_OWUI_USER_CLAIM=name
# Must stay empty: the platform holds Open WebUI's signing secret, LiteLLM must
# not (the hook refuses to start with it). Keep this line if
# another env file loaded before this one sets it.
FORWARD_USER_INFO_HEADER_JWT_SECRET=
