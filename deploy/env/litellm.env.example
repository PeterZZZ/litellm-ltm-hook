# LiteLLM with the hook in platform mode. Copy to $ENV_DIR/litellm.env, chmod 600.
LITELLM_PORT=4011
LITELLM_MASTER_KEY=<sk-...: generate, see SETUP.md step 4>
DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5432/ltmplatform
STORE_MODEL_IN_DB=False
# Provider key(s) for the models in litellm-config.yaml.
DEEPINFRA_API_KEY=<provider key>

# Platform mode: the hook proposes person + namespace, the platform verifies.
MEMMACHINE_PLATFORM=1
MEMMACHINE_BASE_URL=http://127.0.0.1:8100
MEMMACHINE_API_KEY=<mm-svc-...: printed by `mock_platform.admin service add`, step 8>
MEMMACHINE_TIMEOUT=60
MEMMACHINE_MODEL_PREFIX=memmachine-
MEMMACHINE_PROJECT_ID=default
MEMMACHINE_DEBUG=0
# Which claim of Open WebUI's token names the person: name with Corp SSO (Open
# WebUI copies employee_id into the user's name), email without SSO (phase 1).
MEMMACHINE_OWUI_USER_CLAIM=name
# Must stay empty: the platform holds Open WebUI's signing secret, LiteLLM must
# not (the hook refuses to start with it in platform mode). Keep this line if
# another env file loaded before this one sets it.
FORWARD_USER_INFO_HEADER_JWT_SECRET=
