# Stock Open WebUI 0.11.3. Copy to $ENV_DIR/openwebui.env, chmod 600.
OPENWEBUI_PORT=8087
DATA_DIR=/opt/ltm-platform-env/data/openwebui
# Pin Open WebUI's own database: without this it picks up any DATABASE_URL
# another env file on the host exports (e.g. LiteLLM's Postgres).
DATABASE_URL=sqlite:////opt/ltm-platform-env/data/openwebui/webui.db
WEBUI_SECRET_KEY=<random, 32+ bytes>

# Signed user identity to LiteLLM: Open WebUI sends X-OpenWebUI-User-Jwt (HS256).
ENABLE_FORWARD_USER_INFO_HEADERS=true
# Shared with the platform only (registered against the app key), never with LiteLLM.
FORWARD_USER_INFO_HEADER_JWT_SECRET=<random, 32+ bytes>

# Corp SSO (Keycloak). The user's name becomes their employee ID, reset at every login.
ENABLE_OAUTH_SIGNUP=true
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
OAUTH_CLIENT_ID=open-webui
OAUTH_CLIENT_SECRET=<OWUI_OIDC_CLIENT_SECRET from keycloak-clients.env>
OPENID_PROVIDER_URL=http://127.0.0.1:8180/realms/corp/.well-known/openid-configuration
OAUTH_PROVIDER_NAME="Corp SSO"
OAUTH_SCOPES="openid email profile"
OAUTH_USERNAME_CLAIM=employee_id
OAUTH_UPDATE_NAME_ON_LOGIN=true
# These seed Open WebUI's stored config on FIRST start only (see SETUP.md, pitfalls).
ENABLE_LOGIN_FORM=false
DEFAULT_USER_ROLE=user
TASK_MODEL_EXTERNAL=glm-5.2
BYPASS_MODEL_ACCESS_CONTROL=true

ENABLE_OLLAMA_API=false
ENABLE_MEMORIES=false
ENABLE_MEMORY_SYSTEM_CONTEXT=false
ANONYMIZED_TELEMETRY=false
DO_NOT_TRACK=true
SCARF_NO_ANALYTICS=true
