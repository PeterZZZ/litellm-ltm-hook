# The MemMachine-Platform console prototype on :3100 (ltmplat-console.service). Copy to
# $ENV_DIR/console.env, chmod 600. The hosted console in mock mode, as a company's employees see
# it, signed in through Corp SSO, and the platform the LiteLLM hook talks to.
USE_MOCK_API=true
COMPANY_CONSOLE=true
SEMANTIC_MEMORY_DISABLED=true
# Sign in through Keycloak (keycloak-js) instead of the persona switcher.
MOCK_SIGN_IN=keycloak
KEYCLOAK_URL=http://127.0.0.1:8180
INTERNAL_KEYCLOAK_URL=http://127.0.0.1:8180
KEYCLOAK_REALM=corp
KEYCLOAK_CLIENT_ID=memmachine-console
# The gateway's side: the hook's service credential and Open WebUI's token-signing secret.
COMPANY_GATEWAY_CREDENTIAL=<litellm.env MEMMACHINE_API_KEY>
COMPANY_OWUI_SECRET=<openwebui.env FORWARD_USER_INFO_HEADER_JWT_SECRET>
COMPANY_OWUI_ISSUER=open-webui
COMPANY_OWUI_OWNER=open-webui
# Where memories live: MemMachine core, under the person's org and project. Without it the fixture keeps them.
COMPANY_CORE_URL=http://127.0.0.1:8090
COMPANY_CORE_TIMEOUT=60
