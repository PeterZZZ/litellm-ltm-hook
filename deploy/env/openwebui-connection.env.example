# Open WebUI's one connection to LiteLLM: the shared app key for every user.
OPENAI_API_BASE_URLS=http://127.0.0.1:4011/v1
OPENAI_API_KEYS=<the open-webui-app virtual key, step 8>
# Headers on that connection (its index, "0"): Open WebUI names itself, so the
# hook picks its Open WebUI adapter. Seeds a fresh install only; an existing one
# keeps its stored connections (Admin Settings > Connections > Headers).
OPENAI_API_CONFIGS={"0": {"headers": {"x-memmachine-client": "openwebui"}}}
