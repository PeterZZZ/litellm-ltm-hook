# Open WebUI 0.6.5, the customer's version, beside the 0.11.3 one (step 10a).
# Copy to $ENV_DIR/openwebui-0.6.5.env, chmod 600. Same realm, same LiteLLM key,
# its own data directory and database; its LiteLLM connection goes through the signer.
OPENWEBUI_PORT=8091
DATA_DIR=/opt/ltm-platform-env/data/openwebui-0.6.5
DATABASE_URL=sqlite:////opt/ltm-platform-env/data/openwebui-0.6.5/webui.db
WEBUI_SECRET_KEY=<random, 32+ bytes, not the 0.11.3 instance's>

# 0.6.5 forwards the user as plain X-OpenWebUI-User-* headers; the signer turns
# them into the token (owui-signer.env holds the secret; 0.6.5 would ignore it).
ENABLE_FORWARD_USER_INFO_HEADERS=true

# Corp SSO (Keycloak), as for 0.11.3. 0.6.5 has no OAUTH_UPDATE_NAME_ON_LOGIN: the
# name is taken from the employee_id claim at sign-up and kept.
ENABLE_OAUTH_SIGNUP=true
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
OAUTH_CLIENT_ID=open-webui
OAUTH_CLIENT_SECRET=<OWUI_OIDC_CLIENT_SECRET from keycloak-clients.env>
OPENID_PROVIDER_URL=http://127.0.0.1:8180/realms/corp/.well-known/openid-configuration
OAUTH_PROVIDER_NAME="Corp SSO"
OAUTH_SCOPES="openid email profile"
OAUTH_USERNAME_CLAIM=employee_id
# These seed Open WebUI's stored config on FIRST start only (see SETUP.md, pitfalls).
ENABLE_LOGIN_FORM=false
DEFAULT_USER_ROLE=user
TASK_MODEL_EXTERNAL=glm-5.2
BYPASS_MODEL_ACCESS_CONTROL=true

ENABLE_OLLAMA_API=false
ENABLE_MEMORIES=false
ENABLE_MEMORY_SYSTEM_CONTEXT=false
ANONYMIZED_TELEMETRY=false
DO_NOT_TRACK=true
SCARF_NO_ANALYTICS=true
